# kom-cast-be (Spring Boot) 도메인 API 서비스. 기본값: Spring Boot 기본 포트(8080)
VITE_API_BASE_URL=http://localhost:8080

# komcast-tts (FastAPI) 실시간 브리핑 합성 서비스. 기본값: uvicorn 기본 포트(8000)
# 임시 연동 — 나중에 교체될 예정
VITE_TTS_API_BASE_URL=http://localhost:8000

# true로 켜면 오늘의 브리핑을 kom-cast-be(fetchTodayBriefing) 대신 komcast-tts를
# 프론트에서 직접 호출하는 mock으로 받아옴. kom-cast-be가 아직 불안정할 때 API
# 테스트용 스위치.
VITE_USE_MOCK_TODAY_BRIEFING=false

# 정식 로그인 붙기 전까지 kom-cast-be가 사용자 구분에 쓰는 임시 헤더값
VITE_USER_ID=1
